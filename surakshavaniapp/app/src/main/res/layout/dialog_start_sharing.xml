<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Start Temporary Location Sharing"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:text="Authorize trusted circle members to view your live GPS coordinates for a bounded duration."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Session Title / Purpose"
        app:boxStrokeColor="@color/vibrant_purple"
        app:hintTextColor="@color/vibrant_purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Safe Journey Transit"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="Session Expiration Duration:"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rg_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rb_duration_30m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30 Minutes (Quick errand)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_duration_1h"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="1 Hour (Standard commute)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_duration_4h"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4 Hours (Evening out / travel)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_duration_8h"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="8 Hours (Full work/study shift)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rb_duration_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Until Manually Revoked"
            android:textColor="@color/text_primary" />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/badge_safe"
        android:fontFamily="sans-serif"
        android:padding="10dp"
        android:text="🔒 Privacy Guarantee: Once expired or revoked, location transmission halts immediately and live database records are wiped."
        android:textColor="@color/deep_purple"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_session"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/subtle_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_start_session"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/vibrant_purple"
            android:text="Start Sharing"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
