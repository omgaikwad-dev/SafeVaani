<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/woshield_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/woshield_card_bg"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_routine_form"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="New Routine"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="36dp">

            <!-- Section 1: Routine Basics -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/woshield_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="1. Routine Details"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <!-- Title -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Routine Name (e.g. Campus Morning Commute) *"
                        app:boxStrokeColor="@color/deep_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_routine_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Category Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif"
                        android:text="Category"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_routine_category"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/rounded_corner"
                        android:backgroundTint="@color/light_lavender"
                        android:paddingHorizontal="12dp" />

                    <!-- Origin -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Start Location (e.g. Home) *"
                        app:boxStrokeColor="@color/deep_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_routine_start_loc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Destination -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Destination (e.g. Engineering College) *"
                        app:boxStrokeColor="@color/deep_purple">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_routine_destination"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Schedule & Timing -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/woshield_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="2. Schedule &amp; Timings"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <!-- Departure & Arrival Pickers Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Start Time Button -->
                        <LinearLayout
                            android:id="@+id/layout_pick_start_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_corner"
                            android:backgroundTint="@color/light_lavender"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Departure Time"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_start_time_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="08:30 AM"
                                android:textColor="@color/deep_purple"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Arrival Time Button -->
                        <LinearLayout
                            android:id="@+id/layout_pick_arrival_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_corner"
                            android:backgroundTint="@color/light_lavender"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Expected Arrival"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_arrival_time_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="09:15 AM"
                                android:textColor="@color/deep_purple"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Expected Duration -->
                    <TextView
                        android:id="@+id/tv_calculated_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Estimated duration: 45 minutes"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Days of Week Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif"
                        android:text="Scheduled Days *"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <ToggleButton
                            android:id="@+id/tb_mon"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:textOff="Mon"
                            android:textOn="Mon"
                            android:checked="true"
                            android:textSize="11sp" />

                        <ToggleButton
                            android:id="@+id/tb_tue"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:textOff="Tue"
                            android:textOn="Tue"
                            android:checked="true"
                            android:textSize="11sp" />

                        <ToggleButton
                            android:id="@+id/tb_wed"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:textOff="Wed"
                            android:textOn="Wed"
                            android:checked="true"
                            android:textSize="11sp" />

                        <ToggleButton
                            android:id="@+id/tb_thu"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:textOff="Thu"
                            android:textOn="Thu"
                            android:checked="true"
                            android:textSize="11sp" />

                        <ToggleButton
                            android:id="@+id/tb_fri"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:textOff="Fri"
                            android:textOn="Fri"
                            android:checked="true"
                            android:textSize="11sp" />

                        <ToggleButton
                            android:id="@+id/tb_sat"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:textOff="Sat"
                            android:textOn="Sat"
                            android:checked="false"
                            android:textSize="11sp" />

                        <ToggleButton
                            android:id="@+id/tb_sun"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:textOff="Sun"
                            android:textOn="Sun"
                            android:checked="false"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Safe Stops Attachment -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/woshield_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="3. Safe Stops Along Route"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_btn_manage_safe_stops"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="+ Add Place"
                            android:textColor="@color/deep_purple"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Designate safe checkpoints to know where to seek refuge"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Safe Stops Selector Button -->
                    <LinearLayout
                        android:id="@+id/layout_select_safe_stops"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_corner"
                        android:backgroundTint="@color/woshield_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Safe Stop"
                            android:src="@drawable/ic_safe_stop"
                            app:tint="@color/deep_purple" />

                        <TextView
                            android:id="@+id/tv_selected_safe_stops_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Select Safe Stops (None chosen)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Select"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Feature C: Check-In & Safety Preferences -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/woshield_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="4. Check-In &amp; Preferences"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <!-- Reminder Notifications Toggle -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_reminders_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="Departure Reminders"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Receive local notification 10 minutes prior to scheduled departure"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/subtle_border" />

                    <!-- Smart Check-In Switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_checkin_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="Safety Check-In Preference"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Configures expected arrival check-in preference. (Note: Automated emergency escalation is governed in Step 4)."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save & Cancel Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_routine"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/subtle_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_routine"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/deep_purple"
                    android:text="Save Routine"
                    android:textColor="@color/white"
                    app:cornerRadius="14dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
