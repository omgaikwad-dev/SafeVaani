<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_safe_place_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/woshield_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Category & Distance Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/light_lavender"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="POLICE STATION"
                    android:textColor="@color/deep_purple"
                    android:textSize="11sp" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Direction Chip (Real-time cardinal heading) -->
            <LinearLayout
                android:id="@+id/layout_direction_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/status_safe_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:id="@+id/img_direction_compass"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Compass Heading"
                    android:src="@drawable/ic_navigation"
                    app:tint="@color/status_safe" />

                <TextView
                    android:id="@+id/tv_direction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="NE ↗"
                    android:textColor="@color/status_safe"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Distance Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/soft_violet_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Distance Pin"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/deep_purple" />

                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="320 m away"
                    android:textColor="@color/deep_purple"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Place Name -->
        <TextView
            android:id="@+id/tv_place_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="City Central Police Station &amp; Women Desk"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Address / Landmark -->
        <TextView
            android:id="@+id/tv_place_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:text="Station Road, Chowk Circle, Sector 2"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Security / Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Verified"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/status_safe" />

            <TextView
                android:id="@+id/tv_place_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="Open 24/7 • Dedicated Women Desk • CCTV"
                android:textColor="@color/status_safe"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Action Row: Navigate Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_navigate"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="@color/deep_purple"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Navigate (Google Maps)"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="14dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Call"
                android:textColor="@color/deep_purple"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/baseline_call_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="14dp"
                app:iconTint="@color/deep_purple"
                app:strokeColor="@color/deep_purple" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
