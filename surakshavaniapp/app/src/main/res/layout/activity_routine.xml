<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/woshield_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/woshield_card_bg"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_routines"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Daily Routines"
            app:titleTextColor="@color/text_primary"
            app:subtitle="Commute schedules &amp; safe stops"
            app:subtitleTextColor="@color/text_secondary" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Top Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nav_safe_stops"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingHorizontal="4dp"
                android:text="Safe Stops"
                android:textColor="@color/deep_purple"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_safe_stop"
                app:iconTint="@color/deep_purple"
                app:strokeColor="@color/deep_purple" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_map"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:paddingHorizontal="4dp"
                android:text="View Map"
                android:textColor="@color/deep_purple"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/maps_icon"
                app:iconTint="@color/deep_purple"
                app:strokeColor="@color/deep_purple" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_routine"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/deep_purple"
                android:minHeight="44dp"
                android:paddingHorizontal="4dp"
                android:text="New Routine"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Loading State -->
        <ProgressBar
            android:id="@+id/progress_routines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/deep_purple"
            android:visibility="gone" />

        <!-- Empty State Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_empty_routines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/woshield_card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="No Routines"
                    android:src="@drawable/ic_routine"
                    app:tint="@color/deep_purple" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="No Daily Routines Configured"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Set up your recurring commute to college, office, or gym. Attach safe stops along the way and configure departure and arrival reminders."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_create_routine"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/deep_purple"
                    android:text="Create First Routine"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Routines List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_routines"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_routine" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
