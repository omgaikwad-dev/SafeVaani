<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/woshield_bg"
    tools:context=".FakeCallActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/woshield_card_bg"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_fake_call"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:subtitle="Deterrent tools &amp; discreet escape"
            app:subtitleTextColor="@color/text_secondary"
            app:title="Fake Call &amp; Alarm"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <!-- ========================================================= -->
            <!-- SECTION 1: FAKE CALL SIMULATOR CARD                       -->
            <!-- ========================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/woshield_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/rounded_corner"
                            android:backgroundTint="@color/light_lavender"
                            android:contentDescription="Phone Call"
                            android:padding="6dp"
                            android:src="@drawable/baseline_call_24"
                            app:tint="@color/deep_purple" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Fake Incoming Call"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Triggers realistic ringing call to exit unsafe situations"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Caller Selection Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Choose Caller:"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <!-- Caller Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_caller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_caller_dad"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Dad (Rajesh)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_caller_mom"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mom" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_caller_police"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Police Control" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_caller_brother"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Brother" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Delay Selection Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Call Timing:"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <!-- Timing Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_delay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_delay_now"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Instant (Now)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_delay_5s"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In 5 Sec" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_delay_15s"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In 15 Sec" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_delay_30s"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In 30 Sec" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Countdown text if timer is running -->
                    <TextView
                        android:id="@+id/tv_call_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="@color/deep_purple"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- Primary Trigger Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_simulate_call"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/deep_purple"
                        android:fontFamily="sans-serif-medium"
                        android:text="SIMULATE INCOMING CALL"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/baseline_call_24"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/white" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================================= -->
            <!-- SECTION 2: LOUD EMERGENCY SIREN CARD                      -->
            <!-- ========================================================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/woshield_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Loud Security Alarm Siren"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Emits loud alarm sound to attract immediate public attention"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Siren Button -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <View
                            android:id="@+id/glow_effect"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:alpha="0.25"
                            android:background="@drawable/circle_red" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siren_play"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:background="#EF4444"
                            android:contentDescription="Play Siren"
                            android:padding="28dp"
                            android:src="@drawable/emergency"
                            app:elevation="6dp"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_siren_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="TAP FOR LOUD SIREN"
                        android:textColor="#EF4444"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
