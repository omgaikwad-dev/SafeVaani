<?xml version="1.0" encoding="utf-8"?>
<!--
    item_night_plan_step.xml
    Individual plan step item in the Night Plan RecyclerView.
    Shows: emoji icon, title, detail, confidence badge with colored bar.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPlanItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/subtle_border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Left confidence bar -->
        <View
            android:id="@+id/viewConfidenceBar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/confidence_known"
            android:layout_marginEnd="10dp"
            android:minHeight="40dp"/>

        <!-- Emoji icon -->
        <TextView
            android:id="@+id/tvPlanEmoji"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🚌"
            android:textSize="18sp"
            android:background="@color/soft_violet_surface"
            android:layout_marginEnd="12dp"/>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport Option"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPlanDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detail text here"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>

        <!-- Right Action Column: Confidence badge + Navigate Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <!-- Confidence badge -->
            <TextView
                android:id="@+id/tvConfidenceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KNOWN ✓"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:padding="4dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:background="@drawable/badge_rounded"/>

            <!-- Navigate in Google Maps button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemNavigate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:minHeight="32dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="0dp"
                android:text="🧭 Navigate"
                android:textColor="@color/primary_orange"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
