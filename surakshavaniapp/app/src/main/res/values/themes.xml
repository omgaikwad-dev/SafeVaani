<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ========================================================= -->
    <!-- SAFEVAANI SIGNATURE APPLICATION BASE THEME                 -->
    <!-- Matches Website Design System: Cream, Yellow & Orange      -->
    <!-- ========================================================= -->
    <style name="Base.Theme.EmpowHer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/primary_yellow</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/woshield_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/danger_color</item>
        <item name="android:windowBackground">@color/woshield_bg</item>
        <item name="android:statusBarColor">@color/primary_yellow</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="materialCardViewStyle">@style/Widget.Woshield.Card</item>
    </style>

    <style name="Theme.EmpowHer" parent="Base.Theme.EmpowHer" />
    <style name="Theme.WoShield" parent="Base.Theme.EmpowHer" />
    <style name="Theme.NightShift" parent="Base.Theme.EmpowHer" />

    <!-- Style for Circular Images -->
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ========================================================= -->
    <!-- TYPOGRAPHY SCALE STYLES                                   -->
    <!-- ========================================================= -->
    <style name="TextAppearance.Woshield.PageTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Woshield.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextAppearance.Woshield.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Woshield.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Woshield.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_supporting</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Woshield.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ========================================================= -->
    <!-- STANDARDIZED COMPONENT STYLES                             -->
    <!-- ========================================================= -->
    <!-- 1. Cards -->
    <style name="Widget.Woshield.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/subtle_border</item>
        <item name="cardBackgroundColor">@color/woshield_card_bg</item>
    </style>

    <style name="WoshieldFeatureCard" parent="Widget.Woshield.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="WoshieldToolCard" parent="Widget.Woshield.Card">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">1dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="WoshieldSectionTitle" parent="TextAppearance.Woshield.SectionTitle" />

    <!-- 2. Buttons -->
    <style name="Widget.Woshield.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/royal_violet</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Woshield.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/soft_violet_surface</item>
        <item name="android:textColor">@color/royal_violet</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Woshield.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">@color/subtle_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Woshield.Button.Emergency" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">@color/danger_color</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 3. Form Input Style -->
    <style name="Widget.Woshield.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/royal_violet</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/royal_violet</item>
    </style>

    <!-- Preserved Legacy Dashboard Styles for backward compatibility -->
    <style name="DashboardCard">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_width">160dp</item>
        <item name="android:layout_height">150dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="DashboardCardContainer">
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="DashboardIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:tint">@color/royal_violet</item>
    </style>

    <style name="DashboardText">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
